# ============ SERVER & DEPLOYMENT ============
PORT=5000
NODE_ENV=production

# MongoDB Atlas URI (Recommended for cloud/Vercel deployment)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/fluxora?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRE=7d

# Cloudinary (Cloud image storage for listings - recommended for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps (Optional - falls back to Gujarat city list)
VITE_GOOGLE_MAPS_KEY=

# OpenRouter Meta LLaMA 3.3 70B AI (Optional - falls back to local rule-based AI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Client URL for CORS (e.g., https://fluxora.vercel.app or http://localhost:5173)
CLIENT_URL=http://localhost:5173

# Frontend Remote API URL (Only needed if deploying frontend separately from backend)
# VITE_API_URL=https://your-backend-api.com/api
